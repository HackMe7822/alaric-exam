PORT=3000
NODE_ENV=development

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Session settings
JWT_EXPIRY=8h
REFRESH_EXPIRY=7d

# Database
DB_PATH=./database/alaric.db

# Upload limits
MAX_FILE_MB=10

# App URL (used for link generation)
APP_URL=http://localhost:3000
